modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "codegen"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build"

[[workflows.workflow]]
name = "codegen"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec run codegen"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/apex-grid run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/apex-grid run build"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.shared]
LEAD_NOTIFY_EMAIL = "info@apexgrideng.com"
VITE_SITE_URL = "https://apexgrideng.com"
LEAD_NOTIFY_FROM_EMAIL = "info@apexgrideng.com"
OUTREACH_FROM_EMAIL = "info@apexgrideng.com"
ADMIN_EMAILS = "chicomills1@gmail.com"

[userenv.production]
PUBLIC_SITE_URL = "https://apexgrideng.com"
ADMIN_EMAILS = "Chicomills1@gmail.com"
SENDGRID_EVENT_FORWARD_URL = "https://api.kairobot.ai/api/outbound/sendgrid-webhook"
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY = "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEOal9bSguzz66dobt/GtFFFWcc4Ugn9gwvgQX4EiPcpNeb1DhHVdG6E6kfndTHbyupFsYsTJnhiBbG7NQ3v4Csg=="
OUTREACH_REPLY_TO_EMAIL = "replies@reply.apexgrideng.com"
