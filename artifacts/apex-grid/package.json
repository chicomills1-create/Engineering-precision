{
  "name": "@workspace/apex-grid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && PRERENDER_BUNDLE=1 vite build --ssr src/ssr.tsx --config vite.config.ts && tsx scripts/prerender.ts && pnpm run seo:audit:corpus",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run seo:check:route-ownership && pnpm run seo:test:hub-preservation && pnpm run seo:audit:claims && pnpm run seo:audit:corpus",
    "seo:generate": "tsx seo/generate.ts",
    "seo:notify-search-engines": "tsx seo/generate.ts --notify-search-engines",
    "seo:check:route-ownership": "tsx -e \"import { assertRouteOwnership } from './seo/route-ownership.ts'; assertRouteOwnership();\"",
    "seo:test:hub-preservation": "tsx --test seo/route-ownership.test.ts",
    "seo:check:bylines": "tsx seo/check-blog-authorship.ts",
    "seo:test:phase0": "tsx --test seo/phase0-corpus.test.ts",
    "seo:cities:refresh": "tsx seo/refresh-cities-directory.ts",
    "seo:check:city-evidence": "tsx seo/check-city-evidence-links.ts",
    "seo:check:city-evidence:scheduled": "tsx seo/check-city-evidence-links.ts --notify-failures --concurrency=2 --timeout-ms=15000",
    "seo:test:city-evidence": "tsx --test seo/check-city-evidence-links.test.ts",
    "seo:review": "tsx seo/review-report.ts",
    "seo:review:email": "tsx seo/review-email.ts",
    "seo:audit:claims": "tsx seo/audit-claims.ts",
    "seo:audit:corpus": "tsx seo/audit-corpus.ts",
    "seo:audit:phase0-similarity": "tsx seo/audit-phase0-similarity.ts",
    "seo:audit:existing-corpus": "tsx seo/audit-existing-corpus-quality.ts",
    "seo:audit:industry-batch": "tsx seo/audit-industry-batch.ts",
    "seo:audit:industry-discipline-batch": "tsx seo/audit-industry-discipline-batch.ts",
    "seo:audit:national-facility-intent-batch": "tsx seo/audit-national-facility-intent-batch.ts",
    "test:estimate-pricing": "tsx --test src/lib/estimate-pricing.test.ts"
  },
